# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/

# Prisma's generated client (services/*/src/generated/prisma-client) — regenerated by the
# `predev`/`prebuild` npm hooks (added alongside this line) and by each service's
# Dockerfile (`RUN npx prisma generate` in the build stage) from schema.prisma. Committing
# it was bloating the repo and could silently drift from schema.prisma; it's reproducible
# on demand, same as node_modules. Must be **/-prefixed, not plain `src/generated/` — that
# form is anchored to the directory the .gitignore lives in (the repo root, which has no
# top-level src/), so it silently matched nothing for any service's nested src/generated/.
**/src/generated/

# Turborepo
.turbo/

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

