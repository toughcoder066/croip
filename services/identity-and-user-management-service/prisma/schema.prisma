generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Primary identity account categorization.
enum AccountType {
  /// Citizen property owner or tenant subject to municipal rates.
  RATEPAYER
  /// Central government administrator or municipal revenue staff.
  STAFF
}

/// Operational state of a user account.
enum AccountStatus {
  /// Awaiting email or telephone OTP verification.
  PENDING
  /// Fully verified and active.
  ACTIVE
  /// Temporarily or permanently disabled.
  SUSPENDED
}

/// Core user identity record across the Central Platform.
model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String?         @unique
  phone           String?         @unique
  accountType     AccountType     @default(RATEPAYER)
  status          AccountStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  credential      UserCredential?
  ratepayerProfile RatepayerProfile?
  staffProfile    StaffProfile?
  sessions        UserSession[]
  roleAssignments UserRoleAssignment[]

  @@map("users")
}

/// Hashed authentication credentials for password-based logins.
model UserCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// Stateful session tokens issued upon login or 2-step OTP verification.
model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("user_sessions")
}

/// Short-lived One-Time Password (OTP) verification records.
model OtpVerification {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
  @@map("otp_verifications")
}

/// Extended citizen ratepayer profile and progressive KYC metrics.
model RatepayerProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  firstName           String?
  lastName            String?
  fullName            String
  ghanaCardNumber     String?  @unique
  tin                 String?  @unique
  preferredChannels   String[] @default(["SMS"])
  profileCompletionScore Int   @default(20)
  kycTier             String   @default("TIER_1_UNVERIFIED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ratepayer_profiles")
}

/// Government and municipal staff profiles.
model StaffProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  fullName      String
  department    String
  staffIdNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

/// System role definitions.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

/// Atomic system permission codes.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

/// M:N join table associating atomic permissions with roles.
model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// User role assignments with optional concessionaire and MMDA scope constraints.
model UserRoleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  concessionId String?   @db.Uuid
  assemblyId   String?   @db.Uuid
  assignedAt   DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, concessionId, assemblyId])
  @@index([concessionId, assemblyId])
  @@map("user_role_assignments")
}

/// Transactional outbox table ensuring reliable event distribution.
model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String
  eventVersion     Int       @default(1)
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  routingKey       String
  payload          Json
  headers          Json
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Deduplicated idempotent incoming event ledger.
model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

/// Idempotency keys preventing duplicate financial or state-changing requests.
model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  concessionId   String?   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Immutable audit trail capturing operations across the platform.
model AuditRecord {
  id           String    @id @default(uuid()) @db.Uuid
  occurredAt   DateTime  @default(now())
  actorId      String
  actorType    String
  concessionId String?   @db.Uuid
  assemblyId   String?   @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_records")
}
