generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Primary identity account categorization.
enum AccountType {
  /// Citizen property owner or tenant subject to municipal rates.
  RATEPAYER
  /// Central government administrator or municipal revenue staff.
  STAFF
}

/// Operational state of a user account.
enum AccountStatus {
  /// Awaiting email or telephone OTP verification.
  PENDING
  /// Fully verified and active.
  ACTIVE
  /// Temporarily or permanently disabled.
  SUSPENDED
}

/// Operational status of a partner revenue concessionaire.
enum ConcessionaireStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

/// Operational status of a territorial concession contract assignment.
enum AssignmentStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

/// Operational status of machine-to-machine API client credentials.
enum ApiClientStatus {
  ACTIVE
  REVOKED
}

/// Core user identity record across the Central Platform.
model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String?         @unique
  phone           String?         @unique
  accountType     AccountType     @default(RATEPAYER)
  status          AccountStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  credential      UserCredential?
  ratepayerProfile RatepayerProfile?
  staffProfile    StaffProfile?
  sessions        UserSession[]
  roleAssignments UserRoleAssignment[]

  @@map("users")
}

/// Hashed authentication credentials for password-based logins.
model UserCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// Stateful session tokens issued upon login or 2-step OTP verification.
model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("user_sessions")
}

/// Short-lived One-Time Password (OTP) verification records.
model OtpVerification {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
  @@map("otp_verifications")
}

/// Extended citizen ratepayer profile and progressive KYC metrics.
model RatepayerProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  firstName           String?
  lastName            String?
  fullName            String
  ghanaCardNumber     String?
  tin                 String?
  preferredChannels   String[] @default(["SMS"])
  profileCompletionScore Int   @default(20)
  digitalAddress      String?
  kycTier             String   @default("TIER_1_UNVERIFIED")
  kycStatus           String?  @default("TIER_1_UNVERIFIED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ghanaCardNumber])
  @@map("ratepayer_profiles")
}

/// Government and municipal staff profiles.
model StaffProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  fullName      String
  department    String?
  staffIdNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

/// System role definitions.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

/// Atomic system permission codes.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

/// M:N join table associating atomic permissions with roles.
model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// User role assignments with optional concessionaire and MMDA scope constraints.
model UserRoleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  concessionId String?   @db.Uuid
  assemblyId   String?   @db.Uuid
  assignedAt   DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, concessionId, assemblyId])
  @@index([concessionId, assemblyId])
  @@map("user_role_assignments")
}

/// Partner revenue concessionaire organizations operating municipal rating zones.
model Concessionaire {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  registrationNumber String               @unique
  contactEmail       String
  contactPhone       String
  status             ConcessionaireStatus @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  assignments        ConcessionAssignment[]
  apiClients         ConcessionaireApiClient[]

  @@map("concessionaires")
}

/// Metropolitan, Municipal, and District Assemblies (MMDAs) under the Local Governance Act 936.
model MunicipalAssembly {
  id          String                 @id @default(uuid()) @db.Uuid
  code        String                 @unique
  name        String
  region      String
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt

  assignments ConcessionAssignment[]

  @@map("municipal_assemblies")
}

/// Territorial concession contracts assigning an MMDA to a concessionaire.
model ConcessionAssignment {
  id                String           @id @default(uuid()) @db.Uuid
  concessionaireId  String           @db.Uuid
  assemblyId        String           @db.Uuid
  contractStartDate DateTime
  contractEndDate   DateTime
  status            AssignmentStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  concessionaire    Concessionaire    @relation(fields: [concessionaireId], references: [id], onDelete: Cascade)
  assembly          MunicipalAssembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  @@index([assemblyId, status])
  @@index([concessionaireId])
  @@map("concession_assignments")
}

/// Machine-to-machine API client credentials for external concessionaire integrations.
model ConcessionaireApiClient {
  id                 String          @id @default(uuid()) @db.Uuid
  concessionaireId   String          @db.Uuid
  clientId           String          @unique
  clientSecretHash   String
  name               String
  allowedIps         String[]        @default([])
  rateLimitPerMinute Int             @default(600)
  status             ApiClientStatus @default(ACTIVE)
  lastUsedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  concessionaire     Concessionaire  @relation(fields: [concessionaireId], references: [id], onDelete: Cascade)

  @@index([concessionaireId])
  @@map("concessionaire_api_clients")
}

/// Transactional outbox table ensuring reliable event distribution.
model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String
  eventVersion     Int       @default(1)
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  routingKey       String
  payload          Json
  headers          Json
  publishedAt      DateTime?
  occurredAt       DateTime  @default(now())
  attempts         Int       @default(0)
  nextAttemptAt    DateTime? @default(now())
  lockedAt         DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

/// Deduplicated idempotent incoming event ledger.
model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String
  eventType   String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

/// Idempotency keys preventing duplicate financial or state-changing requests.
model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  concessionId   String?   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Immutable audit trail capturing operations across the platform.
model AuditRecord {
  id           String    @id @default(uuid()) @db.Uuid
  occurredAt   DateTime  @default(now())
  actorId      String
  actorType    String
  concessionId String?   @db.Uuid
  assemblyId   String?   @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_records")
}
