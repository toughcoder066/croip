generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  RATEPAYER
  STAFF
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String?         @unique
  phone           String?         @unique
  accountType     AccountType     @default(RATEPAYER)
  status          AccountStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  credential      UserCredential?
  ratepayerProfile RatepayerProfile?
  staffProfile    StaffProfile?
  sessions        UserSession[]
  roleAssignments UserRoleAssignment[]

  @@map("users")
}

model UserCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model OtpVerification {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
  @@map("otp_verifications")
}

model RatepayerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  firstName         String?
  lastName          String?
  fullName          String
  preferredChannels String[] @default(["SMS"])
  tin               String?
  ghanaCardNumber   String?
  digitalAddress    String?
  kycStatus         String   @default("TIER_1_UNVERIFIED")
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ratepayer_profiles")
}

model StaffProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  fullName      String
  department    String?
  staffIdNumber String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?

  permissions RolePermission[]
  userRoles   UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  concessionId String?   @db.Uuid
  assemblyId   String?   @db.Uuid
  assignedAt   DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, concessionId, assemblyId])
  @@index([concessionId, assemblyId])
  @@map("user_role_assignments")
}

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String
  eventVersion     Int       @default(1)
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  routingKey       String
  payload          Json
  headers          Json
  occurredAt       DateTime  @default(now())
  publishedAt      DateTime?
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lockedAt         DateTime?
  lastError        String?

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String    @db.Uuid
  eventType   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  concessionId   String?   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditRecord {
  id           String    @id @default(uuid()) @db.Uuid
  occurredAt   DateTime  @default(now())
  actorId      String
  actorType    String
  concessionId String?   @db.Uuid
  assemblyId   String?   @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_records")
}
