{
  "name": "@croip/identity-and-user-management-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker:outbox": "tsx src/workers/outbox.ts",
    "start:worker:outbox": "node dist/workers/outbox.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/sensible": "6.0.3",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.2",
    "@prometheus-io/client": "0.16.1",
    "@prisma/client": "6.19.3",
    "amqplib": "2.2.0",
    "fastify": "5.12.5",
    "fastify-plugin": "5.1.0",
    "jose": "6.1.0",
    "zod": "4.1.12",
    "@croip/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}