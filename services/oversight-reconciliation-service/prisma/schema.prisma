generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReconciliationRun {
  id                 String   @id @default(uuid()) @db.Uuid
  concessionId       String   @db.Uuid
  periodStart        DateTime
  periodEnd          DateTime
  status             String   @default("COMPLETED")
  totalReportedMinor BigInt   @default(0)
  totalEvidenceMinor BigInt   @default(0)
  totalSettledMinor  BigInt   @default(0)
  matchedCount       Int      @default(0)
  unmatchedCount     Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([concessionId, periodStart, periodEnd])
  @@map("reconciliation_runs")
}

model ReconciliationException {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @db.Uuid
  concessionId  String   @db.Uuid
  severity      String   @default("MEDIUM")
  status        String   @default("OPEN")
  reportedRef   String?
  evidenceRef   String?
  varianceMinor BigInt
  reasonCode    String
  assignedOwner String?
  makerId       String?
  checkerId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([concessionId, status, severity])
  @@map("reconciliation_exceptions")
}


model OutboxEvent {
  id                String    @id @default(uuid()) @db.Uuid
  eventType         String
  eventVersion      Int       @default(1)
  aggregateType     String
  aggregateId       String
  aggregateVersion  Int
  routingKey        String
  payload           Json
  headers           Json
  occurredAt        DateTime  @default(now())
  publishedAt       DateTime?
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lockedAt          DateTime?
  lastError         String?

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String    @db.Uuid
  eventType   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  concessionId   String   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditRecord {
  id           String   @id @default(uuid()) @db.Uuid
  occurredAt   DateTime @default(now())
  actorId      String
  actorType    String
  concessionId String?  @db.Uuid
  assemblyId   String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_records")
}

