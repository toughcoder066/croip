NODE_ENV=development
SERVICE_NAME=platform-governance-service
SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3010
LOG_LEVEL=info
DATABASE_URL=postgresql://idarms:idarms_dev_only@127.0.0.1:5433/platform_governance?schema=public
AUTH_MODE=zitadel
# Zitadel (self-hosted — see the `zitadel` service in docker-compose.yml). These are
# today's localhost dev values: ZITADEL_AUDIENCE is the shared "central-platform"
# Zitadel project ID (not a per-service one). On the office server, point ISSUER/
# JWKS_URI at its real reachable address once Zitadel is bootstrapped there.
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_AUDIENCE=396579532015927301
ZITADEL_JWKS_URI=http://localhost:8080/oauth/v2/keys
ZITADEL_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
# Management API credentials for inviting internal oversight users and provisioning/revoking
# concessionaire API clients (see src/lib/zitadel-management.ts). Leave unset to use the safe
# stub path (users are PENDING_ACTIVATION with no real invite sent; API clients get a
# placeholder credential that will not work against any service's real auth).
# ZITADEL_MANAGEMENT_URL=https://your-instance.zitadel.cloud
# ZITADEL_MANAGEMENT_PAT=<personal access token for a Machine service user with org user-management rights>
# ZITADEL_ORGANIZATION_ID=<your Zitadel org id>
IDARMS_CONTEXT_CLAIM=urn:idarms:context
# Dev-only mail relay for delivering newly-issued/rotated API credentials by email.
# MAILPIT_API_URL=http://mailpit:8025
RABBITMQ_URL=amqp://idarms:idarms_dev_only@127.0.0.1:5672
RABBITMQ_EXCHANGE=croip.domain.v1
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
CORS_ORIGINS=
REQUEST_BODY_LIMIT_BYTES=1048576
SHUTDOWN_GRACE_MS=10000
TRUST_PROXY=false
