generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(50)
  zitadelId  String   @unique @map("zitadel_id") @db.VarChar(100)
  countryId  String?  @map("country_id") @db.Uuid
  email      String   @unique @db.VarChar(255)
  fullName   String   @map("full_name") @db.VarChar(150)
  phone      String?  @db.VarChar(30)
  status     String   @default("PENDING_ACTIVATION") @db.VarChar(20)
  invitedAt  DateTime? @map("invited_at") @db.Timestamptz
  invitedViaStub Boolean @default(false) @map("invited_via_stub")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  socialConnections UserSocialConnection[]
  userRoles         UserRole[]

  @@map("users")
}

// =====================================================================
// RBAC — Role-Based Access Control
//
//   users 1──* user_roles *──1 roles 1──* role_permissions *──1 permissions *──1 resources
//
// A permission is a single (resource, action) pair, e.g. USER_MANAGEMENT:VIEW.
// The access matrix is therefore Resource (rows) × Role (columns) × Action (cells).
// =====================================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  scopeLevel  String   @default("NATIONAL") @map("scope_level") @db.VarChar(20) // NATIONAL | REGIONAL | CONCESSIONAIRE | MUNICIPALITY
  isSystem    Boolean  @default(false) @map("is_system")
  status      String   @default("ACTIVE") @db.VarChar(20)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Resource {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  permissions Permission[]

  @@map("resources")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resourceId  String   @map("resource_id") @db.Uuid
  action      String   @db.VarChar(20) // VIEW | EDIT | CREATE | DELETE
  code        String   @unique @db.VarChar(100) // e.g. USER_MANAGEMENT:VIEW
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  resource        Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([resourceId, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedBy    String   @map("granted_by") @db.VarChar(100)
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  scopeLevel String   @default("NATIONAL") @map("scope_level") @db.VarChar(20)
  scopeRefId String?  @map("scope_ref_id") @db.Uuid // region / concession / assembly id when scoped
  assignedBy String   @map("assigned_by") @db.VarChar(100)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserSocialConnection {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  provider       String    @db.VarChar(50) // 'GOOGLE', 'MICROSOFT', 'GITHUB', 'APPLE'
  providerUserId String    @map("provider_user_id") @db.VarChar(150)
  email          String?   @db.VarChar(255)
  displayName    String?   @map("display_name") @db.VarChar(150)
  avatarUrl      String?   @map("avatar_url") @db.VarChar(500)
  connectedAt    DateTime  @default(now()) @map("connected_at") @db.Timestamptz
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz
  status         String    @default("CONNECTED") @db.VarChar(20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_social_connections")
}


model Concession {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  contactEmail String   @map("contact_email") @db.VarChar(255)
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assemblies ConcessionAssembly[]
  personnel  ConcessionPersonnel[]
  apiClients ApiClient[]

  @@map("concessions")
}

model ConcessionAssembly {
  id            String   @id @default(uuid()) @db.Uuid
  concessionId  String   @map("concession_id") @db.Uuid
  assemblyId    String   @map("assembly_id") @db.Uuid
  contractStart DateTime @map("contract_start") @db.Date
  contractEnd   DateTime @map("contract_end") @db.Date
  status        String   @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  concession Concession @relation(fields: [concessionId], references: [id], onDelete: Cascade)

  @@unique([concessionId, assemblyId])
  @@index([assemblyId, status])
  @@map("concession_assemblies")
}

model ConcessionPersonnel {
  id               String   @id @default(uuid()) @db.Uuid
  concessionId     String   @map("concession_id") @db.Uuid
  externalStaffRef String   @map("external_staff_ref") @db.VarChar(100)
  fullName         String   @map("full_name") @db.VarChar(150)
  phone            String   @db.VarChar(30)
  status           String   @default("ACTIVE") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  concession Concession @relation(fields: [concessionId], references: [id], onDelete: Cascade)

  @@unique([concessionId, externalStaffRef])
  @@index([concessionId, status])
  @@map("concession_personnel")
}

model ApiClient {
  id               String    @id @default(uuid()) @db.Uuid
  concessionId     String    @map("concession_id") @db.Uuid
  clientId         String    @unique @map("client_id") @db.VarChar(100)
  clientSecretHash String    @map("client_secret_hash") @db.VarChar(255)
  status           String    @default("ACTIVE") @db.VarChar(20)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  concession Concession @relation(fields: [concessionId], references: [id], onDelete: Cascade)

  @@index([concessionId, status])
  @@map("api_clients")
}

model OutboxEvent {
  id                String    @id @default(uuid()) @db.Uuid
  eventType         String
  eventVersion      Int       @default(1)
  aggregateType     String
  aggregateId       String
  aggregateVersion  Int
  routingKey        String
  payload           Json
  headers           Json
  occurredAt        DateTime  @default(now())
  publishedAt       DateTime?
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lockedAt          DateTime?
  lastError         String?

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String    @db.Uuid
  eventType   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  concessionId   String   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditRecord {
  id           String   @id @default(uuid()) @db.Uuid
  occurredAt   DateTime @default(now())
  actorId      String
  actorType    String
  concessionId String?  @db.Uuid
  assemblyId   String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_records")
}
