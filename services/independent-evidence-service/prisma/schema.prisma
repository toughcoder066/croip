generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProviderEvidence {
  id              String   @id @default(uuid()) @db.Uuid
  providerId      String
  providerRef     String
  channel         String
  currency        String   @default("GHS")
  grossMinor      BigInt
  feeMinor        BigInt   @default(0)
  netMinor        BigInt
  paymentTime     DateTime
  declaredOutcome String   @default("CONFIRMED")
  accountRef      String?
  rawFeed         Json
  createdAt       DateTime @default(now())

  @@unique([providerId, providerRef])
  @@index([channel, declaredOutcome, paymentTime])
  @@map("provider_evidence")
}

model ControlTotalSubmission {
  id               String   @id @default(uuid()) @db.Uuid
  concessionId     String   @db.Uuid
  authorityCode    String
  periodStart      DateTime
  periodEnd        DateTime
  transactionCount Int
  totalAmountMinor BigInt
  manifestRef      String
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())

  @@index([concessionId, authorityCode, periodStart, periodEnd])
  @@map("control_total_submissions")
}


model OutboxEvent {
  id                String    @id @default(uuid()) @db.Uuid
  eventType         String
  eventVersion      Int       @default(1)
  aggregateType     String
  aggregateId       String
  aggregateVersion  Int
  routingKey        String
  payload           Json
  headers           Json
  occurredAt        DateTime  @default(now())
  publishedAt       DateTime?
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lockedAt          DateTime?
  lastError         String?

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String    @db.Uuid
  eventType   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  concessionId   String   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditRecord {
  id           String   @id @default(uuid()) @db.Uuid
  occurredAt   DateTime @default(now())
  actorId      String
  actorType    String
  concessionId String?  @db.Uuid
  assemblyId   String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_records")
}

