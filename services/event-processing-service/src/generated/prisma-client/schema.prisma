generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventQuarantine {
  id              String    @id @default(uuid()) @db.Uuid
  concessionId    String    @db.Uuid
  assemblyId      String    @db.Uuid
  eventId         String
  eventType       String
  reason          String
  status          String    @default("QUARANTINED")
  payload         Json
  resolvedBy      String?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([concessionId, assemblyId, status])
  @@index([eventId])
  @@map("event_quarantines")
}

model OperationalProjection {
  id             String   @id @default(uuid()) @db.Uuid
  aggregateType  String
  aggregateId    String
  concessionId   String   @db.Uuid
  assemblyId     String   @db.Uuid
  currentVersion Int      @default(1)
  lastEventId    String
  state          Json
  updatedAt      DateTime @updatedAt

  @@unique([aggregateType, aggregateId])
  @@index([concessionId, assemblyId])
  @@map("operational_projections")
}

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String
  eventVersion     Int       @default(1)
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  routingKey       String
  payload          Json
  headers          Json
  occurredAt       DateTime  @default(now())
  publishedAt      DateTime?
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lockedAt         DateTime?
  lastError        String?

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String    @db.Uuid
  eventType   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  concessionId   String   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditRecord {
  id           String   @id @default(uuid()) @db.Uuid
  occurredAt   DateTime @default(now())
  actorId      String
  actorType    String
  concessionId String?  @db.Uuid
  assemblyId   String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_records")
}
