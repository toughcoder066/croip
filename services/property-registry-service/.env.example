NODE_ENV=development
SERVICE_NAME=property-registry-service
SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3020
LOG_LEVEL=info
DATABASE_URL=postgresql://idarms:idarms_dev_only@127.0.0.1:5433/property_registry?schema=public
AUTH_MODE=disabled
ZITADEL_ISSUER=https://auth.croip.gov.gh
ZITADEL_AUDIENCE=property-registry-service
ZITADEL_JWKS_URI=https://auth.croip.gov.gh/oauth/v2/keys
ZITADEL_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
IDARMS_CONTEXT_CLAIM=urn:idarms:context
# Shared Services owns MMDA boundary geometry; property registration calls its zone-membership
# check synchronously to reject properties outside every drawn boundary or that straddle more
# than one. Use the Docker Compose service hostname in containers, localhost:3004 standalone.
SHARED_SERVICES_URL=http://shared-services:3004
RABBITMQ_URL=amqp://idarms:idarms_dev_only@127.0.0.1:5672
RABBITMQ_EXCHANGE=croip.domain.v1
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
CORS_ORIGINS=
REQUEST_BODY_LIMIT_BYTES=1048576
SHUTDOWN_GRACE_MS=10000
TRUST_PROXY=false
