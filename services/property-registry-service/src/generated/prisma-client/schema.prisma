generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id                       String   @id @default(uuid()) @db.Uuid
  code                     String   @unique @db.VarChar(50)
  accountNumber            String?  @unique @map("account_number") @db.VarChar(50)
  propertyName             String?  @map("property_name") @db.VarChar(150)
  assemblyId               String   @map("assembly_id") @db.Uuid
  propertyClass            String?  @map("property_class") @db.VarChar(50)
  buildingStatus           String?  @map("building_status") @db.VarChar(50)
  propertyStatus           String   @default("UNASSESSED") @map("property_status") @db.VarChar(50)
  propertyUse              String   @map("property_use") @db.VarChar(50)
  tenureType               String?  @map("tenure_type") @db.VarChar(50)
  structureType            String?  @map("structure_type") @db.VarChar(50)
  createdByRatepayerId     String?  @map("created_by_ratepayer_id") @db.Uuid
  registrationSource       String   @default("CONCESSION") @map("registration_source") @db.VarChar(30)
  registeredByConcessionId String?  @map("registered_by_concession_id") @db.Uuid
  claimedByRatepayerId     String?  @map("claimed_by_ratepayer_id") @db.Uuid
  verificationStatus       String   @default("PENDING") @map("verification_status") @db.VarChar(30)
  polygonGeoJson           Json     @map("polygon_geojson")
  leaseDurationYears       Int?     @map("lease_duration_years")
  landAreaSqm              Float?   @map("land_area_sqm")
  numberOfFloors           Int?     @map("number_of_floors")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  units         PropertyUnit[]
  photos        PropertyPhoto[]
  documents     PropertyDocument[]
  valuations    PropertyValuation[]
  verifications PropertyVerification[]

  @@index([assemblyId, verificationStatus])
  @@index([code])
  @@index([registrationSource])
  @@map("properties")
}

model PropertyDocumentType {
  id                               String   @id @default(uuid()) @db.Uuid
  code                             String   @unique @db.VarChar(50)
  name                             String   @db.VarChar(150)
  description                      String?  @db.Text
  isPrimaryOwnershipProof          Boolean  @default(true) @map("is_primary_ownership_proof")
  requiredForRatepayerRegistration Boolean  @default(true) @map("required_for_ratepayer_registration")
  createdAt                        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("property_document_types")
}

model PropertyDocument {
  id                   String    @id @default(uuid()) @db.Uuid
  propertyId           String    @map("property_id") @db.Uuid
  documentType         String    @map("document_type") @db.VarChar(50)
  documentNumber       String?   @map("document_number") @db.VarChar(100)
  issuingAuthority     String?   @map("issuing_authority") @db.VarChar(150)
  issueDate            DateTime? @map("issue_date") @db.Date
  mediaUrl             String    @map("media_url") @db.VarChar(500)
  fileSizeBytes        Int?      @map("file_size_bytes")
  mimeType             String?   @default("application/pdf") @map("mime_type") @db.VarChar(100)
  uploadedByActorType  String    @map("uploaded_by_actor_type") @db.VarChar(30)
  uploadedByActorId    String    @map("uploaded_by_actor_id") @db.VarChar(100)
  ratepayerId          String?   @map("ratepayer_id") @db.Uuid
  verificationStatus   String    @default("PENDING") @map("verification_status") @db.VarChar(30)
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz
  verifiedByActorId    String?   @map("verified_by_actor_id") @db.VarChar(100)
  rejectionReason      String?   @map("rejection_reason") @db.Text
  isCapturedOnPremises Boolean   @default(false) @map("is_captured_on_premises")
  premisesLatitude     Float?    @map("premises_latitude")
  premisesLongitude    Float?    @map("premises_longitude")
  premisesGpsAccuracy  Float?    @map("premises_gps_accuracy")
  deviceId             String?   @map("device_id") @db.VarChar(50)
  staffRef             String?   @map("staff_ref") @db.VarChar(50)
  capturedAt           DateTime? @map("captured_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([ratepayerId])
  @@index([verificationStatus])
  @@map("property_documents")
}

model PropertyUnit {
  id             String   @id @default(uuid()) @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  unitIdentifier String   @map("unit_identifier") @db.VarChar(50)
  unitType       String   @default("WHOLE_BUILDING") @map("unit_type") @db.VarChar(30)
  floorLevel     Int      @default(0) @map("floor_level")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_units")
}

model PropertyPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  photoType  String   @map("photo_type") @db.VarChar(30)
  mediaUrl   String   @map("media_url") @db.VarChar(500)
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_photos")
}

model ValuationList {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(200)
  effectiveDate DateTime @map("effective_date") @db.Date
  status        String   @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  valuations PropertyValuation[]

  @@map("valuation_lists")
}

model PropertyValuation {
  id              String   @id @default(uuid()) @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  valuationListId String   @map("valuation_list_id") @db.Uuid
  rateableValue   Decimal  @map("rateable_value") @db.Decimal(14, 2)
  isCurrent       Boolean  @default(true) @map("is_current")
  lvdReference    String   @map("lvd_reference") @db.VarChar(100)
  effectiveDate   DateTime @map("effective_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  valuationList ValuationList @relation(fields: [valuationListId], references: [id], onDelete: Restrict)

  @@unique([propertyId, valuationListId])
  @@index([propertyId, isCurrent])
  @@map("property_valuations")
}

model PropertyVerification {
  id                    String    @id @default(uuid()) @db.Uuid
  propertyId            String    @map("property_id") @db.Uuid
  verifiedByPersonnelId String    @map("verified_by_personnel_id") @db.Uuid
  verifierLatitude      Float     @map("verifier_latitude")
  verifierLongitude     Float     @map("verifier_longitude")
  isWithinPolygon       Boolean   @map("is_within_polygon")
  verifiedSnapshot      Json      @map("verified_snapshot")
  capturedAt            DateTime  @map("captured_at") @db.Timestamptz
  receivedAt            DateTime  @default(now()) @map("received_at") @db.Timestamptz
  outcome               String    @db.VarChar(20)
  notes                 String?   @db.Text
  reviewStatus          String    @default("PENDING") @map("review_status") @db.VarChar(20)
  reviewedByPersonnelId String?   @map("reviewed_by_personnel_id") @db.Uuid
  reviewedAt            DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNotes           String?   @map("review_notes") @db.Text

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([reviewStatus])
  @@map("property_verifications")
}

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String
  eventVersion     Int       @default(1)
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  routingKey       String
  payload          Json
  headers          Json
  occurredAt       DateTime  @default(now())
  publishedAt      DateTime?
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lockedAt         DateTime?
  lastError        String?

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String    @db.Uuid
  eventType   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  concessionId   String   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditRecord {
  id           String   @id @default(uuid()) @db.Uuid
  occurredAt   DateTime @default(now())
  actorId      String
  actorType    String
  concessionId String?  @db.Uuid
  assemblyId   String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_records")
}
