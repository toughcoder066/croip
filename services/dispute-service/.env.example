NODE_ENV=development
SERVICE_NAME=dispute-service
SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3008
LOG_LEVEL=info
DATABASE_URL=postgresql://idarms:idarms_dev_only@127.0.0.1:5433/disputes?schema=public
AUTH_MODE=zitadel
# Zitadel (self-hosted — see the `zitadel` service in docker-compose.yml). These are
# today's localhost dev values: ZITADEL_AUDIENCE is the shared "central-platform"
# Zitadel project ID (not a per-service one). On the office server, point ISSUER/
# JWKS_URI at its real reachable address once Zitadel is bootstrapped there.
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_AUDIENCE=396579532015927301
ZITADEL_JWKS_URI=http://localhost:8080/oauth/v2/keys
ZITADEL_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
IDARMS_CONTEXT_CLAIM=urn:idarms:context
PLATFORM_GOVERNANCE_URL=http://localhost:3010
RABBITMQ_URL=amqp://idarms:idarms_dev_only@127.0.0.1:5672
RABBITMQ_EXCHANGE=croip.domain.v1
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
CORS_ORIGINS=
REQUEST_BODY_LIMIT_BYTES=1048576
SHUTDOWN_GRACE_MS=10000
TRUST_PROXY=false
