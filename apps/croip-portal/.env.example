# CROIP Internal Microservices (Strictly local/internal ingestion only). Every URL here is
# today's localhost dev value — on the office server, point each at that service's real
# reachable address (its Docker Compose service name if the portal runs in the same compose
# network, or the server's LAN hostname/IP otherwise). None of these need to change together;
# update one service at a time as it's actually moved.
PLATFORM_GOVERNANCE_API_URL=http://localhost:3010
OVERSIGHT_RECONCILIATION_API_URL=http://localhost:3005
AUDIT_ASSURANCE_API_URL=http://localhost:3006
PROPERTY_REGISTRY_API_URL=http://localhost:3020
RATEPAYER_CORE_API_URL=http://localhost:3030
REPORTING_GATEWAY_API_URL=http://localhost:3001
SHARED_SERVICES_API_URL=http://localhost:3004
EVENT_PROCESSING_API_URL=http://localhost:3002
INDEPENDENT_EVIDENCE_API_URL=http://localhost:3003
PORTAL_PROXY_URL=http://localhost:4000

# Storage & Uploads. Left unset here on purpose — both upload routes (api/user/avatar,
# api/uploads/avatars/[filename]) fall back to `<repo root>/.storage/uploads` when this is
# unset, which is correct for any machine's local checkout. On the office server, set this
# to an absolute path on a dedicated volume/mount outside the deployed app directory, so
# uploads survive a redeploy.
# STORAGE_DIR=

# Zitadel (self-hosted — see the `zitadel` service in docker-compose.yml). Real login +
# Profile > Connections. Client ID comes from the "croip-portal" OIDC app under the
# "central-platform" project in the local Zitadel console (http://localhost:8080/ui/console).
# ZITADEL_ISSUER must exactly match Zitadel's own ZITADEL_EXTERNALDOMAIN config (it's the
# literal `iss` baked into every token) — on the office server this becomes that server's
# real address, not localhost, and the OIDC app's redirect/post-logout URIs need to be
# re-registered for that address too (see DEPLOYMENT.md).
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_CLIENT_ID=
