generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

// ==========================================
// 1. GEOGRAPHY & ADMINISTRATIVE BOUNDARIES
// ==========================================

model Country {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  iso2      String   @unique @db.Char(2)
  iso3      String   @unique @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  regions Region[]
  users   User[]

  @@map("countries")
}

model Region {
  id              String                                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId       String                                     @map("country_id") @db.Uuid
  name            String                                     @db.VarChar(100)
  code            String                                     @db.VarChar(20)
  polygonGeometry Unsupported("geometry(MultiPolygon,4326)") @map("polygon_geometry")
  createdAt       DateTime                                   @default(now()) @map("created_at") @db.Timestamptz

  country             Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  municipalAssemblies MunicipalAssembly[]
  ratepayers          Ratepayer[]

  @@unique([countryId, code])
  @@unique([countryId, name])
  @@index([countryId])
  @@map("regions")
}

model AssemblyType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  assemblies MunicipalAssembly[]

  @@map("assembly_type")
}

model MunicipalAssembly {
  id              String                                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId        String                                     @map("region_id") @db.Uuid
  assemblyTypeId  String                                     @map("assembly_type_id") @db.Uuid
  name            String                                     @db.VarChar(150)
  code            String                                     @unique @db.VarChar(50)
  polygonGeometry Unsupported("geometry(MultiPolygon,4326)") @map("polygon_geometry")
  createdAt       DateTime                                   @default(now()) @map("created_at") @db.Timestamptz

  region               Region               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  assemblyType         AssemblyType         @relation(fields: [assemblyTypeId], references: [id], onDelete: Restrict)
  properties           Property[]
  ratepayers           Ratepayer[]
  concessionAssemblies ConcessionAssembly[]

  @@unique([regionId, name])
  @@index([regionId])
  @@map("municipal_assemblies")
}

// ==========================================
// 2. ACCESS CONTROL & CORE USERS (ZITADEL)
// ==========================================

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  zitadelId String   @unique @map("zitadel_id") @db.VarChar(100)
  countryId String?  @map("country_id") @db.Uuid
  email     String   @unique @db.VarChar(255)
  fullName  String   @map("full_name") @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  country             Country?             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  reconciliationRuns  ReconciliationRun[]
  socialConnections   UserSocialConnection[]
  resolvedItems       ReconciliationItem[]

  @@index([zitadelId])
  @@index([countryId])
  @@map("users")
}

model UserSocialConnection {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  provider       String    @db.VarChar(50) // 'GOOGLE', 'MICROSOFT', 'GITHUB', 'APPLE'
  providerUserId String    @map("provider_user_id") @db.VarChar(150)
  email          String?   @db.VarChar(255)
  displayName    String?   @map("display_name") @db.VarChar(150)
  avatarUrl      String?   @map("avatar_url") @db.VarChar(500)
  connectedAt    DateTime  @default(now()) @map("connected_at") @db.Timestamptz
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz
  status         String    @default("CONNECTED") @db.VarChar(20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_social_connections")
}


// ==========================================
// 3. CLASSIFICATION & REFERENCE LOOKUPS
// ==========================================

model BuildingStatus {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String     @unique @db.VarChar(30)
  name       String     @db.VarChar(100)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  properties Property[]

  @@map("building_status")
}

model PropertyStatus {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String     @unique @db.VarChar(30)
  name       String     @db.VarChar(100)
  properties Property[]

  @@map("property_status")
}

model PropertyUse {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String     @unique @db.VarChar(30)
  name       String     @db.VarChar(100)
  properties Property[]

  @@map("property_uses")
}

model TenureType {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String     @unique @db.VarChar(30)
  name       String     @db.VarChar(100)
  properties Property[]

  @@map("tenure_types")
}

model StructureType {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String     @unique @db.VarChar(30)
  name       String     @db.VarChar(100)
  properties Property[]

  @@map("structure_types")
}

model PropertyClass {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique @db.VarChar(30)
  name        String     @db.VarChar(100)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  properties  Property[]

  @@map("property_classes")
}

// ==========================================
// 4. PROPERTY CORE & CADASTRAL PARCELS
// ==========================================

model Property {
  id                   String                                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                                     @unique @db.VarChar(50)
  accountNumber        String?                                    @unique @map("account_number") @db.VarChar(50)
  propertyName         String?                                    @map("property_name") @db.VarChar(150)
  assemblyId           String                                     @map("assembly_id") @db.Uuid
  propertyClassId      String                                     @map("property_class_id") @db.Uuid
  buildingStatusId     String                                     @map("building_status_id") @db.Uuid
  propertyStatusId     String                                     @map("property_status_id") @db.Uuid
  propertyUseId        String                                     @map("property_use_id") @db.Uuid
  tenureTypeId         String                                     @map("tenure_type_id") @db.Uuid
  structureTypeId      String                                     @map("structure_type_id") @db.Uuid
  createdByRatepayerId     String?                                    @map("created_by_ratepayer_id") @db.Uuid
  registrationSource       String                                     @default("CONCESSION") @map("registration_source") @db.VarChar(30)
  registeredByConcessionId String?                                    @map("registered_by_concession_id") @db.Uuid
  claimedByRatepayerId     String?                                    @map("claimed_by_ratepayer_id") @db.Uuid
  verificationStatus       String                                     @default("PENDING") @map("verification_status") @db.VarChar(30)
  polygonGeometry          Unsupported("geometry(MultiPolygon,4326)") @map("polygon_geometry")
  leaseDurationYears       Int?                                       @map("lease_duration_years")
  landAreaSqm              Decimal?                                   @map("land_area_sqm") @db.Decimal(12, 2)
  numberOfFloors           Int                                        @default(1) @map("number_of_floors")
  createdAt                DateTime                                   @default(now()) @map("created_at") @db.Timestamptz

  assembly           MunicipalAssembly @relation(fields: [assemblyId], references: [id], onDelete: Restrict)
  propertyClass      PropertyClass     @relation(fields: [propertyClassId], references: [id], onDelete: Restrict)
  buildingStatus     BuildingStatus    @relation(fields: [buildingStatusId], references: [id], onDelete: Restrict)
  propertyStatus     PropertyStatus    @relation(fields: [propertyStatusId], references: [id], onDelete: Restrict)
  propertyUse        PropertyUse       @relation(fields: [propertyUseId], references: [id], onDelete: Restrict)
  tenureType         TenureType        @relation(fields: [tenureTypeId], references: [id], onDelete: Restrict)
  structureType      StructureType     @relation(fields: [structureTypeId], references: [id], onDelete: Restrict)
  createdByRatepayer Ratepayer?        @relation(fields: [createdByRatepayerId], references: [id], onDelete: SetNull)

  units               PropertyUnit[]
  photos              PropertyPhoto[]
  documents           PropertyDocument[]
  valuations          PropertyValuation[]
  verifications       PropertyVerification[]
  bills               PropertyBill[]
  reconciliationItems ReconciliationItem[]
  disputes            Dispute[]

  @@index([assemblyId])
  @@index([propertyClassId])
  @@index([code])
  @@index([accountNumber])
  @@index([registrationSource])
  @@map("properties")
}

model PropertyDocumentType {
  id                               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                             String   @unique @db.VarChar(50)
  name                             String   @db.VarChar(150)
  description                      String?  @db.Text
  isPrimaryOwnershipProof          Boolean  @default(true) @map("is_primary_ownership_proof")
  requiredForRatepayerRegistration Boolean  @default(true) @map("required_for_ratepayer_registration")
  createdAt                        DateTime @default(now()) @map("created_at") @db.Timestamptz

  documents PropertyDocument[]

  @@map("property_document_types")
}

model PropertyDocument {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId           String    @map("property_id") @db.Uuid
  documentTypeId       String    @map("document_type_id") @db.Uuid
  documentNumber       String?   @map("document_number") @db.VarChar(100)
  issuingAuthority     String?   @map("issuing_authority") @db.VarChar(150)
  issueDate            DateTime? @map("issue_date") @db.Date
  mediaUrl             String    @map("media_url") @db.VarChar(500)
  fileSizeBytes        Int?      @map("file_size_bytes")
  mimeType             String?   @default("application/pdf") @map("mime_type") @db.VarChar(100)
  uploadedByActorType  String    @map("uploaded_by_actor_type") @db.VarChar(30)
  uploadedByActorId    String    @map("uploaded_by_actor_id") @db.VarChar(100)
  ratepayerId          String?   @map("ratepayer_id") @db.Uuid
  verificationStatus   String    @default("PENDING") @map("verification_status") @db.VarChar(30)
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz
  verifiedByActorId    String?   @map("verified_by_actor_id") @db.VarChar(100)
  rejectionReason      String?   @map("rejection_reason") @db.Text
  isCapturedOnPremises Boolean   @default(false) @map("is_captured_on_premises")
  premisesLatitude     Float?    @map("premises_latitude")
  premisesLongitude    Float?    @map("premises_longitude")
  premisesGpsAccuracy  Float?    @map("premises_gps_accuracy")
  deviceId             String?   @map("device_id") @db.VarChar(50)
  staffRef             String?   @map("staff_ref") @db.VarChar(50)
  capturedAt           DateTime? @map("captured_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  documentType PropertyDocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@index([ratepayerId])
  @@index([verificationStatus])
  @@map("property_documents")
}

model PropertyUnit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  unitIdentifier String   @map("unit_identifier") @db.VarChar(50)
  unitType       String   @default("WHOLE_BUILDING") @map("unit_type") @db.VarChar(30)
  floorLevel     Int      @default(0) @map("floor_level")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  property       Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ratepayerLinks PropertyRatepayerLink[]

  @@unique([propertyId, unitIdentifier])
  @@map("property_units")
}

model PropertyPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  photoType  String   @map("photo_type") @db.VarChar(30)
  mediaUrl   String   @map("media_url") @db.VarChar(500)
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_photos")
}

model ValuationList {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @unique @db.VarChar(150)
  effectiveDate DateTime @map("effective_date") @db.Date
  status        String   @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  valuations PropertyValuation[]

  @@map("valuation_lists")
}

model PropertyValuation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  valuationListId String   @map("valuation_list_id") @db.Uuid
  rateableValue   Decimal  @map("rateable_value") @db.Decimal(14, 2)
  isCurrent       Boolean  @default(true) @map("is_current")
  lvdReference    String   @map("lvd_reference") @db.VarChar(100)
  effectiveDate   DateTime @map("effective_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  valuationList ValuationList  @relation(fields: [valuationListId], references: [id], onDelete: Restrict)
  bills         PropertyBill[]

  @@unique([propertyId, valuationListId])
  @@index([propertyId, isCurrent])
  @@map("property_valuations")
}

// ==========================================
// 5. RATEPAYERS & IDENTITY KYC
// ==========================================

model Ratepayer {
  id            String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String                              @unique @db.VarChar(50)
  ratepayerType String                              @map("ratepayer_type") @db.VarChar(20)
  legalName     String                              @map("legal_name") @db.VarChar(200)
  phone         String                              @db.VarChar(30)
  email         String?                             @db.VarChar(255)
  location      Unsupported("geometry(Point,4326)") @map("location")
  regionId      String                              @map("region_id") @db.Uuid
  assemblyId    String                              @map("assembly_id") @db.Uuid
  createdAt     DateTime                            @default(now()) @map("created_at") @db.Timestamptz

  region   Region            @relation(fields: [regionId], references: [id], onDelete: Restrict)
  assembly MunicipalAssembly @relation(fields: [assemblyId], references: [id], onDelete: Restrict)

  verifications         RatepayerVerification[]
  propertyLinks         PropertyRatepayerLink[]
  selfCreatedProperties Property[]
  bills                 PropertyBill[]
  payments              BillPayment[]
  disputesRaised        Dispute[]

  @@index([phone])
  @@index([assemblyId])
  @@map("ratepayers")
}

model RatepayerVerification {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ratepayerId        String    @map("ratepayer_id") @db.Uuid
  provider           String    @db.VarChar(50)
  providerReference  String    @map("provider_reference") @db.VarChar(150)
  verificationStatus String    @default("PENDING") @map("verification_status") @db.VarChar(20)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz

  ratepayer Ratepayer @relation(fields: [ratepayerId], references: [id], onDelete: Cascade)

  @@index([ratepayerId])
  @@map("ratepayer_verification")
}

model PropertyRatepayerLink {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId                  String    @map("unit_id") @db.Uuid
  ratepayerId             String    @map("ratepayer_id") @db.Uuid
  ownershipType           String    @default("OWNER") @map("ownership_type") @db.VarChar(30)
  ownershipPercentage     Decimal   @default(100.00) @map("ownership_percentage") @db.Decimal(5, 2)
  isPrimaryBillingContact Boolean   @default(true) @map("is_primary_billing_contact")
  effectiveFrom           DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo             DateTime? @map("effective_to") @db.Date

  unit      PropertyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  ratepayer Ratepayer    @relation(fields: [ratepayerId], references: [id], onDelete: Restrict)

  @@unique([unitId, ratepayerId])
  @@map("property_ratepayer_links")
}

// ==========================================
// 6. EXTERNAL CONCESSIONS & FIELD PERSONNEL
// ==========================================

model Concession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  contactEmail String   @map("contact_email") @db.VarChar(255)
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  assemblies         ConcessionAssembly[]
  personnel          ConcessionPersonnel[]
  apiClients         ApiClient[]
  syncBatches        SyncBatch[]
  bills              PropertyBill[]
  reconciliationRuns ReconciliationRun[]

  @@map("concessions")
}

model ConcessionAssembly {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concessionId  String   @map("concession_id") @db.Uuid
  assemblyId    String   @map("assembly_id") @db.Uuid
  contractStart DateTime @map("contract_start") @db.Date
  contractEnd   DateTime @map("contract_end") @db.Date
  status        String   @default("ACTIVE") @db.VarChar(20)

  concession Concession        @relation(fields: [concessionId], references: [id], onDelete: Restrict)
  assembly   MunicipalAssembly @relation(fields: [assemblyId], references: [id], onDelete: Restrict)

  @@index([concessionId])
  @@index([assemblyId])
  @@map("concession_assemblies")
}

model ConcessionPersonnel {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concessionId     String @map("concession_id") @db.Uuid
  externalStaffRef String @map("external_staff_ref") @db.VarChar(100)
  fullName         String @map("full_name") @db.VarChar(150)
  phone            String @db.VarChar(30)
  status           String @default("ACTIVE") @db.VarChar(20)

  concession        Concession             @relation(fields: [concessionId], references: [id], onDelete: Restrict)
  syncBatches       SyncBatch[]
  verifications     PropertyVerification[] @relation("VerificationSurveyor")
  reviewedVerifications PropertyVerification[] @relation("VerificationReview")
  assignedDisputes  Dispute[]

  @@unique([concessionId, externalStaffRef])
  @@map("concession_personnel")
}

model ApiClient {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concessionId String   @map("concession_id") @db.Uuid
  clientId     String   @unique @map("client_id") @db.VarChar(100)
  status       String   @default("ACTIVE") @db.VarChar(20)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz

  concession Concession @relation(fields: [concessionId], references: [id], onDelete: Restrict)

  @@map("api_clients")
}

// ==========================================
// 7. FIELD OPERATIONS & OFFLINE SYNC
// ==========================================

model SyncBatch {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concessionId String   @map("concession_id") @db.Uuid
  uploadedBy   String   @map("uploaded_by") @db.Uuid
  deviceId     String   @map("device_id") @db.VarChar(100)
  status       String   @default("COMPLETED") @db.VarChar(20)
  itemCount    Int      @map("item_count")
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz

  concession    Concession             @relation(fields: [concessionId], references: [id], onDelete: Restrict)
  personnel     ConcessionPersonnel    @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  verifications PropertyVerification[]
  bills         PropertyBill[]
  payments      BillPayment[]

  @@index([concessionId, receivedAt])
  @@map("sync_batches")
}

model PropertyVerification {
  id               String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId       String                              @map("property_id") @db.Uuid
  verifiedBy       String                              @map("verified_by") @db.Uuid
  syncBatchId      String?                             @map("sync_batch_id") @db.Uuid
  clientEventId    String                              @unique @map("client_event_id") @db.Uuid
  verifierLocation Unsupported("geometry(Point,4326)") @map("verifier_location")
  isWithinPolygon  Boolean                             @map("is_within_polygon")
  verifiedSnapshot Json                                @map("verified_snapshot")
  capturedAt       DateTime                            @map("captured_at") @db.Timestamptz
  receivedAt       DateTime                            @default(now()) @map("received_at") @db.Timestamptz
  outcome          String                              @db.VarChar(20)
  notes            String?                             @db.Text
  reviewStatus      String    @default("PENDING") @map("review_status") @db.VarChar(20)
  reviewedByPersonnelId String? @map("reviewed_by_personnel_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNotes        String?  @map("review_notes") @db.Text

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  surveyor            ConcessionPersonnel  @relation("VerificationSurveyor", fields: [verifiedBy], references: [id], onDelete: Restrict)
  reviewedByPersonnel ConcessionPersonnel? @relation("VerificationReview", fields: [reviewedByPersonnelId], references: [id], onDelete: SetNull)
  syncBatch           SyncBatch?           @relation(fields: [syncBatchId], references: [id], onDelete: SetNull)
  reconciliationItems ReconciliationItem[]

  @@index([propertyId])
  @@index([capturedAt])
  @@index([reviewStatus])
  @@map("property_verifications")
}

// ==========================================
// 8. BILLING, PAYMENTS & GATEWAY SETTLEMENT
// ==========================================

model PropertyBill {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billNumber       String   @unique @map("bill_number") @db.VarChar(50)
  propertyId       String   @map("property_id") @db.Uuid
  ratepayerId      String   @map("ratepayer_id") @db.Uuid
  concessionId     String   @map("concession_id") @db.Uuid
  valuationId      String?  @map("valuation_id") @db.Uuid
  syncBatchId      String?  @map("sync_batch_id") @db.Uuid
  supersedesBillId String?  @map("supersedes_bill_id") @db.Uuid
  billingPeriod    String   @map("billing_period") @db.VarChar(20)
  billType         String   @default("ASSESSED") @map("bill_type") @db.VarChar(20)
  currency         String   @default("GHS") @db.Char(3)
  amountDue        Decimal  @map("amount_due") @db.Decimal(14, 2)
  amountPaid       Decimal  @default(0.00) @map("amount_paid") @db.Decimal(14, 2)
  paymentStatus    String   @default("UNPAID") @map("payment_status") @db.VarChar(20)
  issuedAt         DateTime @default(now()) @map("issued_at") @db.Timestamptz
  dueDate          DateTime @map("due_date") @db.Date
  externalBillRef  String   @map("external_bill_ref") @db.VarChar(100)

  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  ratepayer       Ratepayer          @relation(fields: [ratepayerId], references: [id], onDelete: Restrict)
  concession      Concession         @relation(fields: [concessionId], references: [id], onDelete: Restrict)
  valuation       PropertyValuation? @relation(fields: [valuationId], references: [id], onDelete: SetNull)
  syncBatch       SyncBatch?         @relation(fields: [syncBatchId], references: [id], onDelete: SetNull)
  supersededBy    PropertyBill?      @relation("BillSupersedes", fields: [supersedesBillId], references: [id], onDelete: SetNull)
  supersededBills PropertyBill[]     @relation("BillSupersedes")

  paymentLinks        PaymentLink[]
  payments            BillPayment[]
  reconciliationItems ReconciliationItem[]
  disputes            Dispute[]

  @@unique([concessionId, externalBillRef])
  @@index([propertyId, billingPeriod])
  @@index([paymentStatus])
  @@map("property_bills")
}

model PaymentLink {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId         String   @map("bill_id") @db.Uuid
  amountFixed    Decimal  @map("amount_fixed") @db.Decimal(14, 2)
  status         String   @default("ACTIVE") @db.VarChar(20)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  gatewayLinkRef String   @unique @map("gateway_link_ref") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  bill     PropertyBill  @relation(fields: [billId], references: [id], onDelete: Restrict)
  payments BillPayment[]

  @@index([billId])
  @@index([status, expiresAt])
  @@map("payment_links")
}

model BillPayment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId             String   @map("bill_id") @db.Uuid
  paymentLinkId      String?  @map("payment_link_id") @db.Uuid
  paidByRatepayerId  String?  @map("paid_by_ratepayer_id") @db.Uuid
  syncBatchId        String?  @map("sync_batch_id") @db.Uuid
  relatedPaymentId   String?  @map("related_payment_id") @db.Uuid
  clientEventId      String   @unique @map("client_event_id") @db.Uuid
  externalPaymentRef String   @map("external_payment_ref") @db.VarChar(100)
  paymentType        String   @default("PAYMENT") @map("payment_type") @db.VarChar(20)
  amount             Decimal  @db.Decimal(14, 2)
  balanceAtPayment   Decimal  @map("balance_at_payment") @db.Decimal(14, 2)
  status             String   @default("CONFIRMED") @db.VarChar(20)
  paidAt             DateTime @map("paid_at") @db.Timestamptz
  receivedAt         DateTime @default(now()) @map("received_at") @db.Timestamptz

  bill                PropertyBill         @relation(fields: [billId], references: [id], onDelete: Restrict)
  paymentLink         PaymentLink?         @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  paidByRatepayer     Ratepayer?           @relation(fields: [paidByRatepayerId], references: [id], onDelete: SetNull)
  syncBatch           SyncBatch?           @relation(fields: [syncBatchId], references: [id], onDelete: SetNull)
  relatedPayment      BillPayment?         @relation("PaymentAdjustments", fields: [relatedPaymentId], references: [id], onDelete: SetNull)
  adjustmentPayments  BillPayment[]        @relation("PaymentAdjustments")
  reconciliationItems ReconciliationItem[]

  @@index([billId])
  @@index([paidAt])
  @@map("bill_payments")
}

// ==========================================
// 9. FINANCIAL RECONCILIATION & AUDIT
// ==========================================

model ReconciliationRun {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concessionId String    @map("concession_id") @db.Uuid
  runBy        String    @map("run_by") @db.Uuid
  periodStart  DateTime  @map("period_start") @db.Timestamptz
  periodEnd    DateTime  @map("period_end") @db.Timestamptz
  status       String    @default("COMPLETED") @db.VarChar(20)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz

  concession Concession           @relation(fields: [concessionId], references: [id], onDelete: Restrict)
  officer    User                 @relation(fields: [runBy], references: [id], onDelete: Restrict)
  items      ReconciliationItem[]

  @@index([concessionId, periodStart, periodEnd])
  @@map("reconciliation_runs")
}

model ReconciliationItem {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId           String  @map("run_id") @db.Uuid
  propertyId      String? @map("property_id") @db.Uuid
  verificationId  String? @map("verification_id") @db.Uuid
  billId          String? @map("bill_id") @db.Uuid
  paymentId       String? @map("payment_id") @db.Uuid
  discrepancyType String  @map("discrepancy_type") @db.VarChar(50)
  status          String  @default("OPEN") @db.VarChar(20)
  resolution      String? @db.VarChar(50)
  resolutionRef   String? @map("resolution_ref") @db.VarChar(150)
  resolvedBy      String? @map("resolved_by") @db.Uuid

  run          ReconciliationRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  property     Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  verification PropertyVerification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)
  bill         PropertyBill?         @relation(fields: [billId], references: [id], onDelete: SetNull)
  payment      BillPayment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  resolver     User?                 @relation(fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([discrepancyType, status])
  @@map("reconciliation_items")
}

// ==========================================
// 10. TRANSACTIONAL OUTBOX & INBOX (MESSAGING)
// ==========================================

model OutboxEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType        String    @map("event_type") @db.VarChar(100)
  eventVersion     Int       @default(1) @map("event_version")
  aggregateType    String    @map("aggregate_type") @db.VarChar(100)
  aggregateId      String    @map("aggregate_id") @db.VarChar(100)
  aggregateVersion Int       @map("aggregate_version")
  routingKey       String    @map("routing_key") @db.VarChar(150)
  payload          Json      @db.JsonB
  headers          Json      @db.JsonB
  occurredAt       DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt      DateTime? @map("published_at") @db.Timestamptz
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz
  lastError        String?   @map("last_error") @db.Text

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model InboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumerId  String    @map("consumer_id") @db.VarChar(100)
  messageId   String    @map("message_id") @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(100)
  producer    String    @db.VarChar(100)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  result      Json?     @db.JsonB

  @@unique([consumerId, messageId])
  @@index([processedAt])
  @@map("inbox_events")
}

// ==========================================
// 11. DISPUTES & CASE MANAGEMENT
// ==========================================

model Dispute {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String    @unique @db.VarChar(50)
  disputeType           String    @map("dispute_type") @db.VarChar(20)
  propertyId            String?   @map("property_id") @db.Uuid
  billId                String?   @map("bill_id") @db.Uuid
  raisedByRatepayerId   String    @map("raised_by_ratepayer_id") @db.Uuid
  status                String    @default("OPEN") @map("status") @db.VarChar(20)
  assignedToPersonnelId String?   @map("assigned_to_personnel_id") @db.Uuid
  slaDueAt              DateTime? @map("sla_due_at") @db.Timestamptz
  resolution            String?   @db.Text
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  property     Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  bill         PropertyBill?        @relation(fields: [billId], references: [id], onDelete: SetNull)
  raisedBy     Ratepayer            @relation(fields: [raisedByRatepayerId], references: [id], onDelete: Restrict)
  assignedTo   ConcessionPersonnel? @relation(fields: [assignedToPersonnelId], references: [id], onDelete: SetNull)
  evidence     DisputeEvidence[]
  comments     DisputeComment[]

  @@index([propertyId])
  @@index([billId])
  @@index([raisedByRatepayerId])
  @@index([status, slaDueAt])
  @@map("disputes")
}

model DisputeEvidence {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId           String   @map("dispute_id") @db.Uuid
  mediaUrl            String   @map("media_url") @db.VarChar(500)
  uploadedByActorType String   @map("uploaded_by_actor_type") @db.VarChar(30)
  uploadedByActorId   String   @map("uploaded_by_actor_id") @db.VarChar(100)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_evidence")
}

model DisputeComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  actorType String   @map("actor_type") @db.VarChar(30)
  actorId   String   @map("actor_id") @db.VarChar(100)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_comments")
}
